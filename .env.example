# Local health server works without credentials. Never commit real keys.
PORT=3000
HOST=127.0.0.1
RECORD_DIR=./data/records
# Set to 1 only after configuring the live workspace fields below.
REEVE_ENABLED=0
AMBIGUOUS_API_KEY=
AMBIGUOUS_AGENT_KEY=
AMBIGUOUS_BASE=https://app.ambiguous.ai
WEBHOOK_SECRET=
# Confirm these paths from a real delivery; there are deliberately no guessed defaults.
# Email ID path is relative to data; delivery ID path is relative to the envelope.
WEBHOOK_EMAIL_ID_PATH=
WEBHOOK_DELIVERY_ID_PATH=
PUBLIC_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
APPROVER_USER_ID=
APPROVER_EMAIL=
REQUESTER_USER_ID=
REQUESTER_EMAIL=
CALENDAR_ID=
# Explicit ISO timestamps with timezone for the agreed future change window.
CHANGE_START_AT=
CHANGE_END_AT=
