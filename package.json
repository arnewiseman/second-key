{
  "name": "second-key",
  "version": "0.1.0",
  "private": true,
  "description": "Reeve prepares access changes for human approval; it never executes grants.",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": { "openai": "^6.0.0", "yaml": "^2.8.0" },
  "devDependencies": { "@types/node": "^22.18.0", "typescript": "^5.9.0" }
}
